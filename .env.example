# Copy these NAMES into Vercel -> Project -> Settings -> Environment Variables.
# Never put real values in this file or on GitHub.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Any long random text (40+ characters). Used to sign login cookies.
SESSION_SECRET=

# Password for the first admin account (username: admin). You must change it at first login.
ADMIN_INITIAL_PASSWORD=

# Arkesel SMS
ARKESEL_API_KEY=
SMS_SENDER=JukwaBasic

# Administrator password-recovery email (Gmail + App Password)
RECOVERY_ADMIN_EMAIL=
SMTP_USER=
SMTP_PASS=
